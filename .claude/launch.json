{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "api.index:app", "--app-dir", "web", "--port", "8000"],
      "env": {
        "FOOTNOTE_EMBEDDER": "fastembed",
        "FOOTNOTE_CACHE_DIR": "cache/demo",
        "FASTEMBED_CACHE_PATH": "cache/fastembed",
        "PYTHONIOENCODING": "utf-8"
      },
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    }
  ]
}
